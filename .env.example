APP_NAME=SuperSafeTwin
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://app.example.com
LOG_ROOT=logs
LOG_LEVEL=INFO
ENABLE_DEV_ROUTES=false

DATABASE_URL=postgresql://username:password@localhost:5432/SuperSafeTwin_db

JWT_SECRET_KEY=change-this-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

MODEL_SERVER_URL=http://example.com/transform
MODEL_SERVER_TIMEOUT_SECONDS=300


POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=SuperSafeTwin_db
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

API_PUBLIC_DOMAIN=api.example.com
BACKEND_PORT=8000
BACKEND_RELOAD=true

MINIO_CONSOLE_BIND_ADDRESS=127.0.0.1
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=username
MINIO_ROOT_PASSWORD=password
MINIO_BUCKET_NAME=scan-files
MINIO_PUBLIC_DOMAIN=storage.example.com
MINIO_PUBLIC_SCHEME=https
MINIO_PRESIGNED_URL_EXPIRES_SECONDS=900
FRONTEND_ORIGIN=https://app.example.com
